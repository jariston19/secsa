{
  "name": "secsa",
  "version": "0.1.0",
  "private": true,
  "description": "MCQ diagnostic exam platform by Josiah P. Ariston",
  "author": "Josiah P. Ariston",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"node scripts/dev-backend.cjs\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:seed-analytics": "npm run db:seed-analytics --workspace=backend",
    "db:seed-demo": "npm run db:seed-demo --workspace=backend",
    "db:reset-content": "npm run db:reset-content --workspace=backend",
    "db:reset-qa-diagnostics": "npm run db:reset-qa-diagnostics --workspace=backend",
    "db:seed-trial-students": "npm run db:seed-trial-students --workspace=backend",
    "db:remove-trial-students": "npm run db:remove-trial-students --workspace=backend",
    "db:remove-intake-batches": "npm run db:remove-intake-batches --workspace=backend",
    "db:reset-program-year": "npm run db:reset-program-year --workspace=backend --",
    "db:reset-student-exams": "npm run db:reset-student-exams --workspace=backend --",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "loadtest:exam": "k6 run load-tests/student-exam.js",
    "loadtest:auth": "k6 run load-tests/auth-only.js"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
